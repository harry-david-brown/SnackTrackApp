# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development

# App Configuration
APP_NAME=Snack Track
APP_VERSION=1.0.0

# Development
NODE_ENV=development
DEBUG=true

# Microsoft native identity login (public values; fill in per build environment)
EXPO_PUBLIC_MICROSOFT_LOGIN_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_LOGIN_IOS_REDIRECT_URI=
EXPO_PUBLIC_MICROSOFT_LOGIN_ANDROID_REDIRECT_URI=

# AdMob (required only for production native builds; development uses Google's test IDs)
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_NATIVE_IOS_AD_UNIT_ID=
EXPO_PUBLIC_ADMOB_NATIVE_ANDROID_AD_UNIT_ID=

{
  "name": "snack-track-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/validate-env.js && expo start --port 8081 --clear",
    "start:clean": "pkill -f 'expo start' || pkill -f 'metro' || true; sleep 2; node scripts/validate-env.js && expo start --port 8082 --clear",
    "stop-expo": "pkill -f 'expo start' || pkill -f 'metro' || true",
    "dev": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9000 tcp:9000 && expo start",
    "build:ios": "expo build:ios",
    "setup": "chmod +x scripts/setup.sh && ./scripts/setup.sh",
    "setup:quick": "./scripts/setup.sh",
    "backend:start": "docker compose -f ../SnackTrackAPI/docker-compose.yml up --build",
    "backend:stop": "docker compose -f ../SnackTrackAPI/docker-compose.yml down",
    "backend:reset": "docker compose -f ../SnackTrackAPI/docker-compose.yml down -v && docker compose -f ../SnackTrackAPI/docker-compose.yml up --build",
    "backend:logs": "docker compose -f ../SnackTrackAPI/docker-compose.yml logs -f api worker",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "check:theme": "node scripts/check-theme-colors.cjs",
    "test": "jest",
    "ci": "npm run check:theme && npm run type-check && npm run lint && npm test -- --watchAll=false",
    "audit": "npm audit --audit-level=moderate",
    "clean": "rm -rf node_modules package-lock.json && npm install --legacy-peer-deps",
    "doctor": "expo doctor",
    "verify": "node scripts/verify-setup.js",
    "prepare": "husky",
    "analyze:bundle": "node scripts/analyze-bundle-size.js",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@sentry/react-native": "^7.7.0",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "expo": "~54.0.22",
    "expo-apple-authentication": "^8.0.8",
    "expo-auth-session": "^7.0.9",
    "expo-av": "^16.0.7",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.17",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-localization": "^17.0.7",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.14",
    "expo-secure-store": "^15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "^15.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "16.3.4",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.10",
    "eas-cli": "^16.28.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "jest-expo": "~54.0.13",
    "lint-staged": "^16.2.3",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "private": true
}
